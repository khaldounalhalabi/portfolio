PORT=3001
NODE_ENV=production

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API key used by the Next.js app to authenticate requests to this service
API_KEY=

# Resume storage configuration
RESUME_BUCKET_NAME=resume
RESUME_OBJECT_PATH=khaldoun-alhalabi-resume.pdf

# Optional: local Chrome path for resume PDF generation in development
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome

# SMTP configuration for the contact form emails
SMTP_HOST=
SMTP_PORT=587
# Set to true when using an implicit TLS port (usually 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Address the contact emails are sent from (usually the same as SMTP_USER)
CONTACT_FROM_ADDRESS=
# Address that receives the contact form submissions
CONTACT_TO_ADDRESS=

